{
  "version": 2,
  "buildCommand": "prisma generate && prisma db push --accept-data-loss && node prisma/seed.js && cp -f prisma/dev.db ./dev.db 2>/dev/null || true",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "env": {
    "DATABASE_URL": "file:./dev.db",
    "JWT_SECRET": "finsphere_super_secret_jwt_key_2026",
    "NODE_ENV": "production"
  }
}
